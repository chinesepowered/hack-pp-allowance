# Allowance: environment variables. Names only. Real values go in .env.local
# (git-ignored) or in the Vercel project settings. Sandbox only, never live.

# PayPal sandbox REST app with Vault enabled
# (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID. Safe in the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# A sandbox Personal (buyer) account: this is "Dana's PayPal".
# Used by `pnpm seed` for the one-time save in PayPal's window (Playwright),
# and shown to judges in the README so they can log in to the sandbox.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Printed by `pnpm paypal:webhook <public-url>` after deploying.
PAYPAL_WEBHOOK_ID=

# Channel3 product catalog (trychannel3.com dashboard).
CHANNEL3_API_KEY=

# W&B Inference, OpenAI-compatible (wandb.ai > Inference).
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
OPENAI_VISION_MODEL=google/gemma-4-31B-it
OPENAI_FALLBACK_MODEL=zai-org/GLM-5.3-Flash

# Generate these yourself and keep them only here:
#   openssl rand -hex 32
MANDATE_SIGNING_SECRET=
#   openssl rand -hex 24
DEMO_ADMIN_TOKEN=

# Vercel Blob for app state on the hosted demo (Vercel > Storage > Blob).
# Without it, state lives in .data/ (local) or /tmp (Vercel, not durable).
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public", matching how the Blob store was created.
BLOB_ACCESS=private

# Only for building the demo video (narration and Kip's voice lines).
# The app itself never calls ElevenLabs.
ELEVENLABS_API_KEY=
